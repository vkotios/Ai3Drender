# ---------------------------------------------------------------------------
# Supabase (Postgres + Auth + Storage)
# Leave these unset to run the app in LOCAL mode: an on-disk store under
# ./storage-local is used instead, with a single built-in demo user.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by the pipeline worker to write results on behalf of a user.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Google Gemini - photo analysis, multi-view synthesis, scene art direction.
# Unset => the deterministic offline analyzer is used so the app still runs.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ---------------------------------------------------------------------------
# Mesh reconstruction (images -> .glb). Gemini cannot produce geometry, so this
# is a separate vendor. Pick ONE provider; unset => "stub" (real glTF, blocky
# proportional stand-in geometry) so the full pipeline runs with no accounts.
#   stub | meshy | tripo | fal
# ---------------------------------------------------------------------------
MESH_PROVIDER=stub
MESHY_API_KEY=
TRIPO_API_KEY=
FAL_API_KEY=
# fal model route used when MESH_PROVIDER=fal
FAL_MESH_MODEL=fal-ai/hunyuan3d-v21

# Target ratio (0-1] of vertices the real-time studio viewport's decimated
# preview mesh keeps, generated once at reconstruct time (see
# lib/ai/mesh/simplify.ts). The Blender render worker and glTF/OBJ export
# always use the full-detail mesh regardless of this setting.
VIEWPORT_MESH_SIMPLIFY_RATIO=0.5

# Public base URL, used to build absolute asset URLs for mesh vendors.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Only needed if you drain the queue with a scheduled trigger instead of (or
# alongside) `npm run worker` - see the README's deployment section. Lets
# POST /api/jobs/tick authenticate a scheduler instead of a signed-in user:
# set it here and configure the same value as the trigger's bearer token
# (Vercel Cron reads CRON_SECRET itself and sends it automatically; an
# external cron service needs it set as an Authorization header by hand).
# Unset => that route only accepts the studio's own authenticated poll.
# ---------------------------------------------------------------------------
CRON_SECRET=
