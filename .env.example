# ---------------------------------------------------------------------------
# Supabase (Postgres + Auth + Storage)
# Leave these unset to run the app in LOCAL mode: an on-disk store under
# ./storage-local is used instead, with a single built-in demo user.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by the pipeline worker to write results on behalf of a user.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Google Gemini - photo analysis, multi-view synthesis, scene art direction.
# Unset => the deterministic offline analyzer is used so the app still runs.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ---------------------------------------------------------------------------
# Mesh reconstruction (images -> .glb). Gemini cannot produce geometry, so this
# is a separate vendor. Pick ONE provider; unset => "stub" (real glTF, blocky
# proportional stand-in geometry) so the full pipeline runs with no accounts.
#   stub | meshy | tripo | fal
# ---------------------------------------------------------------------------
MESH_PROVIDER=stub
MESHY_API_KEY=
TRIPO_API_KEY=
FAL_API_KEY=
# fal model route used when MESH_PROVIDER=fal
FAL_MESH_MODEL=fal-ai/hunyuan3d-v21

# Public base URL, used to build absolute asset URLs for mesh vendors.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Only needed if you drain the queue with a scheduled trigger instead of (or
# alongside) `npm run worker` - see the README's deployment section. Lets
# POST /api/jobs/tick authenticate a scheduler instead of a signed-in user:
# set it here and configure the same value as the trigger's bearer token
# (Vercel Cron reads CRON_SECRET itself and sends it automatically; an
# external cron service needs it set as an Authorization header by hand).
# Unset => that route only accepts the studio's own authenticated poll.
#
# Also gates POST /api/notifications/reminders/tick below, the same way.
# ---------------------------------------------------------------------------
CRON_SECRET=

# ---------------------------------------------------------------------------
# Notifications - tell the owner a client left a note or a verdict, instead
# of them having to reopen the studio to notice. Each channel is independent
# and unset => silently skipped; posting/sending both fail soft, so a bad
# webhook or API key never blocks the client's note or verdict from saving.
#
#   Slack   - a message is posted to this Incoming Webhook
#             (https://api.slack.com/messaging/webhooks) whenever a client
#             leaves a note or sets an approval verdict through a share link.
#   Resend  - emails the project owner on the same two events, and (see
#             REMINDER_THRESHOLD_DAYS below) reminds them about a share link
#             nobody has opened. Get a key at https://resend.com - Postmark
#             is an equally simple drop-in if you already use it instead;
#             see lib/notify/email.ts.
#
# Reply-to-a-review-note-by-plain-email (inbound email parsing) is out of
# scope here - see the PR for #46.
# ---------------------------------------------------------------------------
SLACK_WEBHOOK_URL=

RESEND_API_KEY=
# `from` address on outgoing notification emails. Needs a domain verified
# with Resend, or their emails will not send.
NOTIFICATIONS_FROM_EMAIL=notifications@ai3drender.dev
# Days a share link can go unopened before POST /api/notifications/reminders/tick
# emails the owner about it. Re-sent every this-many days for as long as it
# stays unopened, not just once.
REMINDER_THRESHOLD_DAYS=3
